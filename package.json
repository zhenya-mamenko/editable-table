{
  "name": "@mamenko/editable-table",
  "type": "module",
  "private": false,
  "version": "0.2.0",
  "description": "Vue 3 (Vuetify 4 based) tablelike component",
  "module": "./dist/editable-table.js",
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": "./dist/editable-table.js"
  },
  "types": "./dist/editable-table.d.ts",
  "keywords": [
    "component",
    "library",
    "vue",
    "vue3",
    "vuetify",
    "vuetify4"
  ],
  "author": "Zhenya Mamenko",
  "license": "MIT",
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outFile dist/editable-table.d.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@rollup/plugin-strip": "^3.0.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "magic-string": "^1.4.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^4.0.0"
  },
  "bugs": {
    "url": "https://github.com/zhenya-mamenko/editable-table/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhenya-mamenko/editable-table.git"
  }
}

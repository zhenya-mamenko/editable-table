    "vuetify": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "sass": "^1.108.1",
    "unplugin-fonts": "^2.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.7",
    "vite-plugin-vuetify": "^2.1.3"
  }
